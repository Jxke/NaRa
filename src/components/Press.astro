---
import { getPressEntries } from "../lib/press.js";

const entries = await getPressEntries();

const paragraphs = (text) =>
  (text ?? "").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const formatDate = (value) =>
  value
    ? new Date(`${value}T00:00:00Z`).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        timeZone: "UTC",
      })
    : null;
---

<ol class="press-entries">
  {entries.map(({ id, kind, title, date, description, url, links, photos }) => {
    const allLinks = [
      ...(url ? [{ label: "Read more", url }] : []),
      ...(links ?? []),
    ];
    return (
      <li id={id}>
        <article class="press-entry">
          <header class="press-meta">
            <p class="label">{kind}</p>
            {date && <p class="label">{formatDate(date)}</p>}
          </header>
          <div class="press-body">
            <h2>
              {url ? <a href={url}>{title}</a> : title}
            </h2>
            {paragraphs(description).map((p) => <p>{p}</p>)}
            {photos?.length > 0 && (
              <div class="press-photos">
                {photos.map(({ src, alt, caption }) => (
                  <figure>
                    <img src={src} alt={alt} loading="lazy" />
                    {caption && <figcaption>{caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
            {allLinks.length > 0 && (
              <ul class="press-links">
                {allLinks.map(({ label, url }) => (
                  <li><a class="button button-outline" href={url}>{label} ↗</a></li>
                ))}
              </ul>
            )}
          </div>
        </article>
      </li>
    );
  })}
</ol>
